<Window x:Class="NetworkFolderManager.Dialogs.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NetworkFolderManager.Services"
        Title="{loc:Tr 'Eingehender Anruf'}"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Background="#0A0A0F"
        Foreground="#F5F5F7"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Rectangle Height="1" VerticalAlignment="Top" Margin="60,0" Fill="{StaticResource ReflectionLine}"/>
        <StackPanel Margin="28,26,28,24">
            <Grid Width="72" Height="72" Margin="0,0,0,14">
                <Ellipse Fill="{StaticResource AvatarBrush}"/>
                <TextBlock x:Name="InitialText" Foreground="Black" FontWeight="Bold" FontSize="30"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="NameText" Style="{StaticResource Headline}" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="KindText" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,4,0,22"/>
            <UniformGrid Columns="2">
                <Button Content="{loc:Tr 'Ablehnen'}" Style="{StaticResource GlassButton}" Click="Decline_Click" IsCancel="True" Margin="0,0,6,0"/>
                <Button Content="{loc:Tr 'Annehmen'}" IsDefault="True" Click="Accept_Click" Margin="6,0,0,0"/>
            </UniformGrid>
        </StackPanel>
    </Grid>
</Window>
