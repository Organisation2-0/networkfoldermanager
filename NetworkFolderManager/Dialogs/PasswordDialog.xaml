<Window x:Class="NetworkFolderManager.Dialogs.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anmeldedaten"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#0A0A0F"
        Foreground="#F5F5F7"
        FontFamily="{StaticResource AppFont}">
    <Grid>
        <Rectangle Height="1" VerticalAlignment="Top" Margin="60,0" Fill="{StaticResource ReflectionLine}"/>
        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="Anmeldung für Netzwerkordner" Style="{StaticResource Headline}" FontSize="18" Margin="0,0,0,6"/>

            <TextBlock x:Name="FolderLabel" Style="{StaticResource DimText}" Margin="0,0,0,16"/>

            <TextBlock Text="Benutzername" Margin="0,0,0,4" FontWeight="Medium"/>
            <TextBox x:Name="UsernameTextBox" Margin="0,0,0,4"/>
            <TextBlock Text="z.B. Benutzer, COMPUTER\Benutzer oder name@domain" Style="{StaticResource DimText}" FontSize="11" Margin="2,0,0,12"/>

            <TextBlock Text="Passwort" Margin="0,0,0,4" FontWeight="Medium"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14" PasswordChar="●"/>

            <CheckBox x:Name="SavePasswordCheckBox" IsChecked="True" Margin="0,0,0,2"
                      Content="Passwort sicher speichern (nicht erneut fragen)"/>
            <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="48,0,0,10"
                       Text="Wird verschlüsselt in der Windows-Anmeldeinformationsverwaltung abgelegt."/>
            <CheckBox x:Name="RememberCheckBox" Content="Als Netzlaufwerk-Verbindung merken" Margin="0,0,0,18"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" IsCancel="True" Style="{StaticResource GlassButton}" Click="Cancel_Click"/>
                <Button Content="Verbinden" IsDefault="True" Click="Connect_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
