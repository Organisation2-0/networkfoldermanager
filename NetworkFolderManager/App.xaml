<Application x:Class="NetworkFolderManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NetworkFolderManager.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/NoobnetTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:InverseBooleanConverter x:Key="InverseBool"/>
            <conv:ImagePathConverter x:Key="ImagePath"/>
            <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility"/>

            <!-- Alias für ältere Verweise -->
            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource GlassButton}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
