<Window x:Class="NetworkFolderManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NetworkFolderManager.Services"
        xmlns:vm="clr-namespace:NetworkFolderManager.ViewModels"
        Title="NetworkFolderManager"
        Width="1180"
        Height="780"
        MinWidth="900"
        MinHeight="600"
        Background="#000000"
        Foreground="#F5F5F7"
        FontFamily="{StaticResource AppFont}"
        AllowDrop="True"
        Icon="pack://application:,,,/appicon.ico"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <ContentControl Style="{StaticResource AmbientBackground}">
        <Grid Margin="18,14,18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TabControl x:Name="MainTabs" SelectionChanged="MainTabs_SelectionChanged">

                <!-- =========================================================
                     TAB 1: ORDNER
                     ========================================================= -->
                <TabItem Header="{loc:Tr 'Ordner'}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="6*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ordnerliste -->
                        <ContentControl Grid.Column="0" Style="{StaticResource GlassCard}" Margin="0,0,7,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Netzwerkordner'}"/>

                                <WrapPanel Grid.Row="1" Margin="-4,0,-4,4">
                                    <Button Content="{loc:Tr 'Netzwerk scannen'}" Command="{Binding ScanNetworkCommand}"/>
                                    <Button Content="{loc:Tr 'Verbinden'}" Style="{StaticResource GlassButton}" Command="{Binding ConnectToFolderCommand}"/>
                                    <Button Content="{loc:Tr 'Trennen'}" Style="{StaticResource GlassButton}" Command="{Binding DisconnectFromFolderCommand}"/>
                                    <Button Content="{loc:Tr 'Öffnen'}" Style="{StaticResource GlassButton}" Command="{Binding OpenInExplorerCommand}"/>
                                    <Button Content="{loc:Tr 'Passwort vergessen'}" Style="{StaticResource GlassButton}" Command="{Binding ForgetPasswordCommand}"
                                            ToolTip="{loc:Tr 'Gespeichertes Passwort für diesen Server löschen'}"/>
                                </WrapPanel>

                                <Grid Grid.Row="2" Margin="0,4,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ManualPath, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="{loc:Tr 'UNC-Pfad manuell hinzufügen, z.B. \\\\SERVER\\Freigabe'}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding AddManualFolderCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <TextBlock Grid.Column="0" Text="{loc:Tr '\\\\Server\\Freigabe hinzufügen'}" IsHitTestVisible="False"
                                               Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"
                                               Visibility="{Binding ManualPath, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}"/>
                                    <Button Grid.Column="1" Content="+" MinWidth="0" Width="40" Padding="0" FontSize="18" Margin="6,0,0,0" ToolTip="{loc:Tr 'Hinzufügen'}"
                                            Command="{Binding AddManualFolderCommand}"/>
                                    <Button Grid.Column="2" Content="–" MinWidth="0" Width="40" Padding="0" FontSize="18" Margin="6,0,0,0" ToolTip="{loc:Tr 'Manuellen Ordner entfernen'}"
                                            Style="{StaticResource GlassButton}" Command="{Binding RemoveManualFolderCommand}"/>
                                </Grid>

                                <ListBox Grid.Row="3"
                                         ItemsSource="{Binding NetworkFolders}"
                                         SelectedItem="{Binding SelectedFolder}"
                                         MouseDoubleClick="FolderList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Glass}"
                                                        BorderBrush="{StaticResource Border}" BorderThickness="1" Margin="0,0,12,0">
                                                    <Grid>
                                                        <TextBlock Text="📁" FontFamily="Segoe UI Emoji" FontSize="16"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="#555559"
                                                                 Stroke="Black" StrokeThickness="2"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                        <Border Style="{StaticResource Badge}" Background="#2600D4FF"
                                                                Visibility="{Binding IsOwnFolder, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{loc:Tr 'eigener Ordner'}" FontSize="10" Foreground="{StaticResource Accent}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" Background="{StaticResource GlassStrong}"
                                                                ToolTip="{loc:Tr 'Passwort gespeichert'}"
                                                                Visibility="{Binding HasSavedCredentials, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{loc:Tr ' gespeichert'}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI" FontSize="10" Foreground="{StaticResource TextDim}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" Background="{StaticResource GlassStrong}"
                                                                Visibility="{Binding IsManual, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{loc:Tr 'manuell'}" FontSize="10" Foreground="{StaticResource TextDim}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource DimText}" TextWrapping="NoWrap"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter TargetName="StateDot" Property="Fill" Value="#30D158"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <DockPanel Grid.Row="4" Margin="2,8,2,0">
                                    <TextBlock Style="{StaticResource DimText}"><Run Text="{Binding NetworkFolders.Count, Mode=OneWay}"/><Run Text="{loc:Tr ' Ordner'}"/></TextBlock>
                                    <TextBlock Style="{StaticResource DimText}" HorizontalAlignment="Right"
                                               Text="{loc:Tr '● grün = verbunden · Doppelklick = öffnen/verbinden'}"/>
                                </DockPanel>
                            </Grid>
                        </ContentControl>

                        <!-- Rechte Seite -->
                        <Grid Grid.Column="1" Margin="7,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Upload -->
                            <ContentControl Grid.Row="0" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Datei-Upload'}"/>
                                    <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,10">
                                        <Run Text="{loc:Tr 'Ziel:'}"/>
                                        <Run Text="{Binding SelectedFolder.Path, Mode=OneWay, TargetNullValue={loc:Tr 'links einen Ordner auswählen'}, FallbackValue={loc:Tr 'links einen Ordner auswählen'}}"
                                             Foreground="{StaticResource Text}" FontWeight="SemiBold"/>
                                    </TextBlock>

                                    <Border CornerRadius="14" Padding="14" BorderThickness="1" BorderBrush="#4000D4FF" Background="#0A00D4FF">
                                        <TextBlock Text="{loc:Tr 'Dateien hierher ziehen – oder auswählen:'}" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Accent}"/>
                                    </Border>

                                    <WrapPanel Margin="-4,6,-4,0">
                                        <Button Content="{loc:Tr 'Eine Datei'}" Command="{Binding UploadFileCommand}"/>
                                        <Button Content="{loc:Tr 'Mehrere Dateien'}" Style="{StaticResource GlassButton}" Command="{Binding UploadMultipleFilesCommand}"/>
                                        <Button Content="{loc:Tr 'Abbrechen'}" Style="{StaticResource GlassButton}" Command="{Binding CancelUploadCommand}"
                                                Visibility="{Binding IsUploading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    </WrapPanel>

                                    <ProgressBar Margin="0,8,0,0" Maximum="100" Value="{Binding UploadProgress}"
                                                 Visibility="{Binding IsUploading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding UploadStatus}" Foreground="{StaticResource Success}" Margin="0,6,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding UploadStatus, Converter={StaticResource NotEmptyToVisibility}}"/>
                                </StackPanel>
                            </ContentControl>

                            <!-- Überwachung -->
                            <ContentControl Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="#2630D158"
                                                Visibility="{Binding IsMonitoring, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{loc:Tr '● aktiv'}" FontSize="11" Foreground="{StaticResource Success}"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Eigener Ordner – Benachrichtigungen'}"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding OwnFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                                 IsEnabled="{Binding IsMonitoring, Converter={StaticResource InverseBool}}"/>
                                        <Button Grid.Column="1" Content="…" MinWidth="0" Width="40" Padding="0" Margin="6,0,0,0" ToolTip="{loc:Tr 'Ordner auswählen'}"
                                                Style="{StaticResource GlassButton}" Command="{Binding BrowseOwnFolderCommand}"/>
                                    </Grid>
                                    <WrapPanel Margin="-4,6,-4,0">
                                        <Button Content="{loc:Tr 'Überwachung starten'}" Command="{Binding StartMonitoringCommand}"/>
                                        <Button Content="{loc:Tr 'Stoppen'}" Style="{StaticResource GlassButton}" Command="{Binding StopMonitoringCommand}"/>
                                        <Button Content="{loc:Tr 'Ausgewählten Ordner verwenden'}" Style="{StaticResource GlassButton}" Command="{Binding UseAsOwnFolderCommand}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding MonitorStatus}" Style="{StaticResource DimText}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </ContentControl>

                            <!-- Empfangene Dateien -->
                            <ContentControl Grid.Row="2" Style="{StaticResource GlassCard}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Neu im eigenen Ordner'}"/>
                                    <TextBlock Grid.Row="1" Style="{StaticResource DimText}" Text="{loc:Tr 'Noch keine neuen Dateien.'}"
                                               Visibility="{Binding ReceivedFiles.Count, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}"/>
                                    <ListBox Grid.Row="1" ItemsSource="{Binding ReceivedFiles}" x:Name="ReceivedList"
                                             MouseDoubleClick="ReceivedList_MouseDoubleClick"
                                             ToolTip="{loc:Tr 'Doppelklick zeigt die Datei im Explorer'}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource DimText}" VerticalAlignment="Center"
                                                               Text="{Binding DetectedAt, StringFormat='{}{0:dd.MM. HH:mm}'}"/>
                                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </ContentControl>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- =========================================================
                     TAB 2: CHAT
                     ========================================================= -->
                <TabItem x:Name="ChatTab">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Chat" Foreground="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"/>
                            <Border Background="{StaticResource Accent}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" Margin="6,0,0,0"
                                    Visibility="{Binding Chat.HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding Chat.TotalUnread}" Foreground="Black" FontSize="10" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </TabItem.Header>

                    <Grid DataContext="{Binding Chat}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Kontakte -->
                        <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,7,0" Padding="10,16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Personen im Netzwerk'}" Margin="8,0,0,8"/>

                                <ListBox Grid.Row="1" ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="42" Height="42" Margin="0,0,12,0">
                                                    <Ellipse Fill="{StaticResource AvatarBrush}"/>
                                                    <TextBlock Text="{Binding Initial}" Foreground="Black" FontWeight="Bold" FontSize="17"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Ellipse x:Name="OnlineDot" Width="12" Height="12" Fill="#555559" Stroke="Black" StrokeThickness="2"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="Preview" Text="{Binding LastMessagePreview}" Style="{StaticResource DimText}"
                                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{StaticResource Accent}" CornerRadius="10" MinWidth="20" Height="20"
                                                        Padding="6,0" VerticalAlignment="Center" Margin="6,0,0,0"
                                                        Visibility="{Binding HasUnread, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding UnreadCount}" Foreground="Black" FontSize="11" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                                    <Setter TargetName="OnlineDot" Property="Fill" Value="#30D158"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding LastMessagePreview}" Value="">
                                                    <Setter TargetName="Preview" Property="Text" Value="{Binding StatusText}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Grid.Row="2" Margin="8,8,8,0">
                                    <TextBlock Text="{Binding NetworkStatus}" Style="{StaticResource DimText}"/>
                                    <Button Content="{loc:Tr 'Empfangene Dateien öffnen'}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                            Margin="0,6,0,0" Command="{Binding OpenReceiveFolderCommand}"/>
                                </StackPanel>
                            </Grid>
                        </ContentControl>

                        <!-- Unterhaltung -->
                        <ContentControl Grid.Column="1" Style="{StaticResource GlassCard}" Margin="7,0,0,0" Padding="0">
                            <Grid>
                                <!-- Leerzustand -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            Visibility="{Binding HasSelectedPeer, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}">
                                    <TextBlock Text="💬" FontFamily="Segoe UI Emoji" FontSize="48" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{loc:Tr 'Wähle links eine Person aus'}" Style="{StaticResource Headline}" HorizontalAlignment="Center" Margin="0,10,0,6"/>
                                    <TextBlock Style="{StaticResource DimText}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="380"
                                               Text="{loc:Tr 'Alle im Netzwerk, die NetworkFolderManager installiert haben, erscheinen hier automatisch. Nachrichten, Bilder und Dateien gehen direkt von PC zu PC.'}"/>
                                </StackPanel>

                                <Grid Visibility="{Binding HasSelectedPeer, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Kopfzeile -->
                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,12">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{loc:Tr 'Verlauf löschen'}" Style="{StaticResource GlassButton}"
                                                    Padding="12,6" Command="{Binding DeleteChatCommand}"/>
                                            <Grid Width="40" Height="40" Margin="0,0,12,0">
                                                <Ellipse Fill="{StaticResource AvatarBrush}"/>
                                                <TextBlock Text="{Binding SelectedPeer.Initial}" Foreground="Black" FontWeight="Bold" FontSize="16"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedPeer.DisplayName}" FontWeight="Bold" FontSize="15"/>
                                                <TextBlock Text="{Binding SelectedPeer.StatusText}" Style="{StaticResource DimText}"/>
                                                <TextBlock Style="{StaticResource DimText}" FontSize="11" Foreground="{StaticResource Success}"
                                                           ToolTip="{loc:Tr 'Sicherheitsnummer dieses Kontakts – zum Abgleichen mit der Person (steht bei ihr unter Einstellungen).'}">
                                                    <Run Text="{loc:Tr '🔒 Verschlüsselt · Sicherheitsnummer'}"/>
                                                    <Run Text="{Binding SelectedPeer.SecurityCode, Mode=OneWay}" FontFamily="Consolas"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- Warnung: Schlüssel geändert -->
                                    <Border Grid.Row="1" VerticalAlignment="Top" Panel.ZIndex="1" Margin="16,10" CornerRadius="12" Padding="14,10"
                                            Background="#F02A0F0E" BorderBrush="#80FF453A" BorderThickness="1"
                                            Visibility="{Binding SelectedPeer.KeyChanged, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{loc:Tr 'Neuen Schlüssel akzeptieren'}" Style="{StaticResource GlassButton}"
                                                    Command="{Binding AcceptNewKeyCommand}" VerticalAlignment="Center"/>
                                            <TextBlock TextWrapping="Wrap" Foreground="#FFB4AE" VerticalAlignment="Center"
                                                       Text="{loc:Tr '⚠ Der Sicherheitsschlüssel dieses Kontakts hat sich geändert. Das passiert nach einer Neuinstallation – kann aber auch bedeuten, dass sich jemand als diese Person ausgibt. Nachrichten werden bis zur Bestätigung nicht gesendet. Fragen Sie die Person am besten kurz persönlich.'}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- Nachrichten -->
                                    <ScrollViewer Grid.Row="1" x:Name="MessageScroller" VerticalScrollBarVisibility="Auto" Padding="16,10">
                                        <ItemsControl ItemsSource="{Binding SelectedPeer.Messages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="Bubble" Margin="0,3" Padding="10,8" MaxWidth="460"
                                                            HorizontalAlignment="Left" CornerRadius="16,16,16,4"
                                                            Background="{StaticResource BubbleIn}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                                        <StackPanel>
                                                            <!-- Bild -->
                                                            <Button Style="{StaticResource PlainButton}" Margin="0,0,0,4"
                                                                    Command="{Binding DataContext.Chat.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    ToolTip="{Binding FileName}">
                                                                <Border CornerRadius="10" ClipToBounds="True">
                                                                    <Image Source="{Binding FilePath, Converter={StaticResource ImagePath}, ConverterParameter=440}"
                                                                           MaxHeight="320" MaxWidth="420" Stretch="Uniform" HorizontalAlignment="Left"/>
                                                                </Border>
                                                            </Button>

                                                            <!-- Datei -->
                                                            <Button Style="{StaticResource PlainButton}" Margin="0,0,0,4"
                                                                    Command="{Binding DataContext.Chat.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Border CornerRadius="10" Background="#14FFFFFF" Padding="10,8">
                                                                    <DockPanel>
                                                                        <TextBlock Text="📄" FontFamily="Segoe UI Emoji" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                        <StackPanel>
                                                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                                                                            <TextBlock Style="{StaticResource DimText}">
                                                                                <Run Text="{Binding FileSizeText, Mode=OneWay}"/>
                                                                                <Run Text="{loc:Tr ' · Klicken zum Öffnen'}"/>
                                                                            </TextBlock>
                                                                        </StackPanel>
                                                                    </DockPanel>
                                                                </Border>
                                                            </Button>

                                                            <!-- Text (markierbar) -->
                                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                                                     Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource Text}"
                                                                     Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox.Template>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                                                                    </ControlTemplate>
                                                                </TextBox.Template>
                                                            </TextBox>

                                                            <!-- Fortschritt -->
                                                            <ProgressBar x:Name="Progress" Height="4" Margin="0,6,0,2" Maximum="100" Value="{Binding Progress}" Visibility="Collapsed"/>

                                                            <!-- Fehler -->
                                                            <StackPanel x:Name="ErrorPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,0">
                                                                <TextBlock Text="{loc:Tr 'Nicht zugestellt. '}" Foreground="{StaticResource Danger}" FontSize="11"/>
                                                                <Button Content="{loc:Tr 'Erneut senden'}" Style="{StaticResource LinkButton}" FontSize="11"
                                                                        Command="{Binding DataContext.Chat.RetryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" ToolTip="{Binding Error}"/>
                                                            </StackPanel>

                                                            <!-- Zeit + Status -->
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,0,0">
                                                                <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dd.MM. HH:mm}'}" FontSize="10" Foreground="{StaticResource TextDim}"/>
                                                                <TextBlock x:Name="StatusIcon" Text="{Binding StatusIcon}" FontSize="10" Margin="5,0,0,0"
                                                                           Foreground="{StaticResource TextDim}" FontFamily="Segoe UI Emoji, Segoe UI Symbol"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="{loc:Tr 'Im Ordner anzeigen'}"
                                                                          Command="{Binding PlacementTarget.Tag.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                          CommandParameter="{Binding}"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Border.Tag>
                                                            <Binding Path="DataContext.Chat" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                        </Border.Tag>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Outgoing}" Value="True">
                                                            <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter TargetName="Bubble" Property="CornerRadius" Value="16,16,4,16"/>
                                                            <Setter TargetName="Bubble" Property="Background" Value="{StaticResource BubbleOut}"/>
                                                            <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource BubbleOutBorder}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Delivered">
                                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource Accent}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter TargetName="ErrorPanel" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="StatusIcon" Property="Foreground" Value="{StaticResource Danger}"/>
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Status}" Value="Sending"/>
                                                                <Condition Binding="{Binding HasText}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Progress" Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Status}" Value="Sending"/>
                                                                <Condition Binding="{Binding IsImage}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Progress" Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Status}" Value="Sending"/>
                                                                <Condition Binding="{Binding IsFile}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter TargetName="Progress" Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Eingabe -->
                                    <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE723;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" ToolTip="{loc:Tr 'Bild oder Datei senden'}"
                                                    Command="{Binding AttachFileCommand}" VerticalAlignment="Bottom"/>
                                            <TextBox x:Name="ChatInput" Grid.Column="1" Margin="6,4"
                                                     Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140"
                                                     VerticalScrollBarVisibility="Auto"
                                                     PreviewKeyDown="ChatInput_PreviewKeyDown"/>
                                            <TextBlock Grid.Column="1" Margin="18,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                                       Foreground="{StaticResource TextDim}"
                                                       Text="{loc:Tr 'Nachricht schreiben… (Enter = senden, Strg+V = Bild einfügen)'}"
                                                       Visibility="{Binding MessageText, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}"/>
                                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE724;" ToolTip="{loc:Tr 'Senden'}"
                                                    AutomationProperties.Name="Senden"
                                                    Background="{StaticResource Accent}" Foreground="Black" BorderBrush="Transparent"
                                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                                    Command="{Binding SendCommand}" VerticalAlignment="Bottom"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ContentControl>
                    </Grid>
                </TabItem>

                <!-- =========================================================
                     TAB 3: EINSTELLUNGEN
                     ========================================================= -->
                <TabItem Header="{loc:Tr 'Einstellungen'}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,7,0">
                                <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Profil'}"/>
                                        <TextBlock Style="{StaticResource DimText}" Text="{loc:Tr 'So sehen dich andere im Chat:'}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"/>
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Sprache'}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Button Content="Deutsch" Style="{StaticResource GlassButton}" Command="{Binding SetLanguageGermanCommand}"/>
                                            <Button Content="English" Style="{StaticResource GlassButton}" Command="{Binding SetLanguageEnglishCommand}"/>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource DimText}" Text="{Binding LanguageStatus}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Start &amp; Hintergrund'}"/>
                                        <CheckBox Content="{loc:Tr 'Mit Windows starten (im Infobereich)'}" IsChecked="{Binding Autostart}"/>
                                        <CheckBox Content="{loc:Tr 'Beim Schließen im Infobereich weiterlaufen'}" IsChecked="{Binding MinimizeToTray}"/>
                                        <CheckBox Content="{loc:Tr 'Ordner-Überwachung beim Start automatisch aktivieren'}" IsChecked="{Binding MonitorOnStartup}"/>
                                        <CheckBox Content="{loc:Tr 'Benachrichtigung bei neuen Chat-Nachrichten'}" IsChecked="{Binding ChatNotifications}"/>
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding VersionText}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Updates'}"/>
                                        </DockPanel>
                                        <CheckBox Content="{loc:Tr 'Automatisch aktualisieren (empfohlen)'}" IsChecked="{Binding AutoUpdate}"/>
                                        <TextBlock Style="{StaticResource DimText}" Margin="48,0,0,6"
                                                   Text="{loc:Tr 'Sucht regelmäßig nach neuen Versionen, lädt sie geprüft herunter und installiert sie (Windows fragt dabei nach Administratorrechten).'}"/>
                                        <WrapPanel Margin="-4,0">
                                            <Button Content="{loc:Tr 'Jetzt nach Updates suchen'}" Style="{StaticResource GlassButton}" Command="{Binding CheckForUpdatesCommand}"/>
                                            <Button Content="{loc:Tr 'Update installieren'}" Command="{Binding InstallUpdateCommand}"
                                                    Visibility="{Binding HasUpdate, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource DimText}" Margin="0,4,0,0"
                                                   Visibility="{Binding UpdateStatus, Converter={StaticResource NotEmptyToVisibility}}"/>
                                        <Button Content="{loc:Tr 'Versionshinweise auf GitHub'}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                                Margin="0,6,0,0" Command="{Binding OpenReleasesPageCommand}"/>
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Chat-Dateien'}"/>
                                        <TextBlock Style="{StaticResource DimText}" Margin="0,0,0,6"
                                                   Text="{loc:Tr 'Hier werden empfangene Bilder und Dateien gespeichert:'}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Chat.ReceiveFolder, UpdateSourceTrigger=LostFocus}"/>
                                            <Button Grid.Column="1" Content="…" MinWidth="0" Width="40" Padding="0" Margin="6,0,0,0"
                                                    ToolTip="{loc:Tr 'Ordner auswählen'}" Style="{StaticResource GlassButton}"
                                                    Command="{Binding Chat.BrowseReceiveFolderCommand}"/>
                                        </Grid>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="{loc:Tr 'Ordner öffnen'}" Style="{StaticResource LinkButton}" Margin="0,0,16,0"
                                                    Command="{Binding Chat.OpenReceiveFolderCommand}"/>
                                            <Button Content="{loc:Tr 'Standard (Dokumente) wiederherstellen'}" Style="{StaticResource LinkButton}"
                                                    Command="{Binding Chat.ResetReceiveFolderCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ContentControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="7,0,0,0">
                                <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Mein Netzwerkordner'}"/>
                                        <TextBlock Text="{Binding OwnShareInfo}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <Button Content="{loc:Tr 'Im Explorer öffnen'}" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                                Command="{Binding OpenOwnShareCommand}"
                                                Visibility="{Binding HasOwnShare, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- Status: geschützt / ungeschützt / verschlüsselt -->
                                        <Border CornerRadius="12" Padding="12,10" Margin="0,8,0,0" Background="#1A30D158" BorderBrush="#4D30D158" BorderThickness="1"
                                                Visibility="{Binding IsShareProtected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr '🔒 Passwortgeschützt'}" FontWeight="SemiBold" Foreground="{StaticResource Success}"/>
                                                <TextBlock Text="{Binding ShareAccessInfo}" Style="{StaticResource DimText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border CornerRadius="12" Padding="12,10" Margin="0,8,0,0" Background="#26FF453A" BorderBrush="#80FF453A" BorderThickness="1"
                                                Visibility="{Binding IsShareUnprotected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{loc:Tr '⚠ Ohne Passwort – gefährlich!'}" FontWeight="Bold" Foreground="{StaticResource Danger}"/>
                                                <TextBlock Style="{StaticResource DimText}" Margin="0,2,0,0" Foreground="#FFB4AE"
                                                           Text="{loc:Tr 'Jeder im Netzwerk mit Zugang zu diesem PC kann Dateien lesen, ändern, löschen oder Schadsoftware ablegen. Bitte unten ein Passwort festlegen.'}"/>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding ShareEncryptionInfo, StringFormat='🔐 {0}'}" Style="{StaticResource DimText}" Margin="0,6,0,0"
                                                   Visibility="{Binding ShareEncryptionInfo, Converter={StaticResource NotEmptyToVisibility}}"/>

                                        <TextBlock Style="{StaticResource DimText}" Margin="0,14,0,6"
                                                   Text="{loc:Tr 'Ordner anlegen/freigeben oder Passwort ändern. Für den Zugang wird ein eigenes Windows-Konto mit diesem Passwort angelegt – Ihr persönliches Passwort bleibt geheim. (Administratorrechte erforderlich)'}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{loc:Tr 'Ordner:'}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextDim}"/>
                                            <TextBox Grid.Column="1" Text="{Binding NewSharePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                            <TextBlock Grid.Row="1" Text="{loc:Tr 'Freigabename:'}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextDim}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewShareName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"/>
                                            <TextBlock Grid.Row="2" Text="{loc:Tr 'Passwort:'}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextDim}"/>
                                            <PasswordBox x:Name="SharePasswordBox" Grid.Row="2" Grid.Column="1" Margin="0,2" PasswordChar="●"/>
                                            <TextBlock Grid.Row="3" Text="{loc:Tr 'Wiederholen:'}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource TextDim}"/>
                                            <PasswordBox x:Name="SharePasswordConfirmBox" Grid.Row="3" Grid.Column="1" Margin="0,2" PasswordChar="●"/>
                                        </Grid>
                                        <TextBlock Style="{StaticResource DimText}" FontSize="11" Margin="0,4,0,0" Foreground="#FFB4AE"
                                                   Text="{loc:Tr 'Leeres Passwort = Ordner ohne Schutz (nicht empfohlen, gefährlich).'}"/>
                                        <Button Content="{loc:Tr '🛡  Einrichten / Passwort ändern'}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                Click="SetupShare_Click"/>
                                    </StackPanel>
                                </ContentControl>

                                <ContentControl Style="{StaticResource GlassCard}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:Tr 'Hinweise'}"/>
                                        <TextBlock Style="{StaticResource DimText}"
                                                   Text="{loc:Tr '• Chat und Erkennung funktionieren nur in Netzwerken, die in Windows als „Privat“ eingestuft sind (Einstellungen → Netzwerk &amp; Internet → Eigenschaften).'}"/>
                                        <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                                                   Text="{loc:Tr '• Nachrichten, Bilder und Dateien im Chat gehen direkt von PC zu PC im lokalen Netz – ohne Server, TLS-verschlüsselt. Jeder Kontakt wird beim ersten Kontakt an seinem Schlüssel erkannt; ändert sich dieser, warnt das Programm.'}"/>
                                        <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                                                   Text="{loc:Tr '• Passwörter für fremde Netzwerkordner werden verschlüsselt in der Windows-Anmeldeinformationsverwaltung gespeichert.'}"/>
                                        <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                                                   Text="{loc:Tr '• Fehlerprotokoll (bei Problemen bitte mitschicken): %APPDATA%\\NetworkFolderManager\\error.log'}"/>
                                        <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0">
                                            <Run Text="{loc:Tr '• Ihre Sicherheitsnummer im Chat:'}"/>
                                            <Run Text="{Binding Chat.OwnSecurityCode, Mode=OneWay}" FontFamily="Consolas" Foreground="{StaticResource Accent}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource DimText}" Margin="0,4,0,0"
                                                   Text="{loc:Tr '• Empfangene Bilder und Dateien landen im Ordner unter „Chat-Dateien“ (Standard: Dokumente\\NetworkFolderManager).'}"/>
                                    </StackPanel>
                                </ContentControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Statuszeile -->
            <Border Grid.Row="1" CornerRadius="12" Background="{StaticResource Glass}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" Padding="14,8" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDim}" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>
    </ContentControl>
</Window>
