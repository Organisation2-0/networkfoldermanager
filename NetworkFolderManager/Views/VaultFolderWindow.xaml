<Window x:Class="NetworkFolderManager.Views.VaultFolderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:NetworkFolderManager.Services"
        Title="{Binding Title}"
        Width="1180" Height="760" MinWidth="760" MinHeight="480"
        Background="#0B0B0E" Foreground="#F5F5F7"
        FontFamily="{StaticResource AppFont}"
        Icon="pack://application:,,,/NetworkFolderManager;component/appicon.ico"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <!-- Seitenleisten-Eintrag (iCloud-artig) -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="10,8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Bd" Property="Background" Value="#2600D4FF"/>
                                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon-Button für Werkzeugleiste/Betrachter -->
        <Style x:Key="ToolIcon" TargetType="Button" BasedOn="{StaticResource GlassButton}">
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <Style x:Key="ViewerButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="20" Background="#26FFFFFF">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Listeneinträge ohne Auswahlrahmen (Foto-Zeilen) -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dokument-Symbol mit Endung -->
        <DataTemplate x:Key="FileIcon">
            <Grid Width="56" Height="66">
                <Path Data="M6,1 L36,1 L52,17 L52,62 A3,3 0 0 1 49,65 L6,65 A3,3 0 0 1 3,62 L3,4 A3,3 0 0 1 6,1 Z"
                      Fill="#1E1E22" Stroke="#33FFFFFF" StrokeThickness="1.2"/>
                <Path Data="M36,1 L36,14 A3,3 0 0 0 39,17 L52,17" Stroke="#33FFFFFF" StrokeThickness="1.2"/>
                <Border Background="{Binding KindBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,0,0,12"
                        Visibility="{Binding Ext, Converter={StaticResource NotEmptyToVisibility}}">
                    <TextBlock Text="{Binding Ext}" FontSize="9" FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
        </DataTemplate>

        <ContextMenu x:Key="ItemMenu" x:Shared="False">
            <MenuItem Header="{loc:Tr 'Öffnen'}" Tag="open" Click="ItemMenu_Click"/>
            <MenuItem Header="{loc:Tr 'Herunterladen'}" Tag="download" Click="ItemMenu_Click"/>
            <MenuItem Header="{loc:Tr 'Umbenennen'}" Tag="rename" Click="ItemMenu_Click"/>
            <Separator/>
            <MenuItem Header="{loc:Tr 'Löschen'}" Tag="delete" Click="ItemMenu_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Seitenleiste ================= -->
        <Border Background="#111114" BorderBrush="#14FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">
                <StackPanel DockPanel.Dock="Top" Margin="6,0,6,14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding FolderName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ServerName}" Style="{StaticResource DimText}" Margin="22,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="{Binding StatsText}" Style="{StaticResource DimText}" Margin="10,0,0,8"/>
                    <Button Style="{StaticResource NavButton}" Command="{Binding LockCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Sperren &amp; schließen'}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <Button x:Name="NavPhotos" Style="{StaticResource NavButton}" Command="{Binding ShowPhotosCommand}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PhotoCount}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE91B;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Fotos'}"/>
                        </DockPanel>
                    </Button>
                    <Button x:Name="NavFiles" Style="{StaticResource NavButton}" Command="{Binding ShowFilesCommand}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding FileCount}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Dateien'}"/>
                        </DockPanel>
                    </Button>

                    <TextBlock Text="{loc:Tr 'ORDNER'}" FontSize="11" FontWeight="SemiBold" Foreground="#6E6E73" Margin="10,18,0,6"/>
                    <Button Style="{StaticResource NavButton}" Command="{Binding MountDriveCommand}"
                            ToolTip="{loc:Tr 'Ordner im Explorer als Laufwerk einbinden (WebDAV, verschlüsselt übertragen)'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8CE;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DriveButtonText}" TextWrapping="Wrap" MaxWidth="160"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding ChangePasswordCommand}"
                            Visibility="{Binding IsMine, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Passwort ändern'}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" Width="26" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Aktualisieren'}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Inhalt ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Werkzeugleiste -->
            <DockPanel Margin="22,14,16,8" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Visibility="{Binding IsFiles, Converter={StaticResource BooleanToVisibilityConverter}}" Width="170" Margin="0,0,6,0">
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,10,7"/>
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{StaticResource TextDim}" Margin="11,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE8FD;" Command="{Binding ToggleLayoutCommand}" ToolTip="{loc:Tr 'Liste / Symbole'}"
                            Visibility="{Binding IsFiles, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Style="{StaticResource ToolIcon}" Content="&#xE8F4;" Command="{Binding NewFolderCommand}" ToolTip="{loc:Tr 'Neuer Ordner'}"
                            Visibility="{Binding IsFiles, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Command="{Binding UploadCommand}" Margin="6,3,0,3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{StaticResource Icons}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr 'Hochladen'}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Titel bzw. Pfad -->
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr 'Fotos'}" FontSize="24" FontWeight="Bold"
                               Visibility="{Binding IsPhotos, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ItemsControl ItemsSource="{Binding Crumbs}" Visibility="{Binding IsFiles, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Sep" Text="›" FontSize="20" Foreground="#6E6E73" Margin="4,0" VerticalAlignment="Center"/>
                                    <Button Style="{StaticResource PlainButton}" Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Path}">
                                        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" Margin="2,0"/>
                                    </Button>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Path}" Value="/">
                                        <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DockPanel>

            <!-- Fotos -->
            <ListBox x:Name="PhotoList" Grid.Row="1" ItemsSource="{Binding PhotoRows}" ItemContainerStyle="{StaticResource PlainItem}"
                     Visibility="{Binding IsPhotos, Converter={StaticResource BooleanToVisibilityConverter}}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" Padding="18,0,10,0"
                     SizeChanged="PhotoList_SizeChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Text="{Binding Header}" FontSize="17" FontWeight="SemiBold" Margin="2,14,0,8"
                                       Visibility="{Binding IsHeader, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource PlainButton}" Width="154" Height="154" Margin="0,0,4,4" ToolTip="{Binding Name}"
                                                Command="{Binding DataContext.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                ContextMenu="{StaticResource ItemMenu}">
                                            <Grid>
                                                <Rectangle RadiusX="4" RadiusY="4" Fill="#1C1C1F"/>
                                                <TextBlock Text="&#xE91B;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="#3A3A3F"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Rectangle RadiusX="4" RadiusY="4">
                                                    <Rectangle.Fill>
                                                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Border Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                        Background="#99000000" CornerRadius="4">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="26" Foreground="White" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#CCFFFFFF" Margin="8,6,8,0" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Dateien: Symbole -->
            <ListBox x:Name="FileGrid" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Padding="16,0,10,0"
                     MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsFiles}" Value="True"/>
                                    <Condition Binding="{Binding IsListLayout}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Padding" Value="6,10"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="112">
                            <Grid Width="96" Height="76" HorizontalAlignment="Center">
                                <!-- Ordner -->
                                <TextBlock Text="&#xE8D5;" FontFamily="{StaticResource Icons}" FontSize="64" Foreground="#5AC8FA"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsDir, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <!-- Datei -->
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FileIcon}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ContentPresenter.Style>
                                        <Style TargetType="ContentPresenter">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDir}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentPresenter.Style>
                                </ContentPresenter>
                                <!-- Bild -->
                                <Border Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}" CornerRadius="6"
                                        Background="#1C1C1F">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                       FontSize="12" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding SubText}" TextAlignment="Center" Style="{StaticResource DimText}" FontSize="11"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Dateien: Liste -->
            <ListBox x:Name="FileList" Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Padding="16,0,10,0"
                     MouseDoubleClick="FileList_MouseDoubleClick" KeyDown="FileList_KeyDown"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsFiles}" Value="True"/>
                                    <Condition Binding="{Binding IsListLayout}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="ContextMenu" Value="{StaticResource ItemMenu}"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Margin" Value="0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8D5;" FontFamily="{StaticResource Icons}" FontSize="20" Foreground="#5AC8FA" VerticalAlignment="Center"
                                       Visibility="{Binding IsDir, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Border Width="22" Height="18" CornerRadius="3" Background="{Binding KindBrush}" HorizontalAlignment="Left"
                                    Visibility="{Binding IsDir, Converter={StaticResource NotEmptyToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="{Binding Ext}" FontSize="7" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource DimText}" VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Leer / Laden -->
            <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Style="{StaticResource DimText}" FontSize="14" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource AllTrueToVisibility}">
                        <Binding Path="IsEmpty"/>
                        <Binding Path="IsLoading" Converter="{StaticResource InverseBool}"/>
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>
            <ProgressBar Grid.Row="1" IsIndeterminate="True" Width="160" VerticalAlignment="Top" Margin="0,6,0,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- Status / Upload -->
            <Border Grid.Row="2" Background="#111114" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0" Padding="18,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Visibility="{Binding IsUploading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding UploadText}" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ProgressBar Width="180" Value="{Binding UploadProgress}" Maximum="100" VerticalAlignment="Center"/>
                        <Button Content="{loc:Tr 'Abbrechen'}" Style="{StaticResource LinkButton}" Margin="10,0,0,0" Command="{Binding CancelUploadCommand}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource DimText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               VerticalAlignment="Center" MinHeight="16"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ================= Betrachter ================= -->
        <Grid x:Name="Viewer" Grid.ColumnSpan="2" Background="Black" Focusable="True"
              Visibility="{Binding IsViewerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Source="{Binding ViewerImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,56,0,36"/>
            <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Margin="0,56,0,36"
                          MouseLeftButtonUp="Video_Click" Cursor="Hand"/>
            <ScrollViewer Margin="80,70,80,50" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding ViewerText, Converter={StaticResource NotEmptyToVisibility}}">
                <TextBox Text="{Binding ViewerText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                         Background="#111114" Padding="16" BorderThickness="0"/>
            </ScrollViewer>
            <ProgressBar IsIndeterminate="True" Width="200" VerticalAlignment="Bottom" Margin="0,0,0,14"
                         Visibility="{Binding ViewerLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <Border VerticalAlignment="Top" Padding="10,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#CC000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource ViewerButton}" Content="&#xE711;" Command="{Binding CloseViewerCommand}" ToolTip="{loc:Tr 'Schließen (Esc)'}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ViewerButton}" Content="&#xE74D;" Command="{Binding ViewerDeleteCommand}" ToolTip="{loc:Tr 'Löschen'}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ViewerButton}" Content="&#xE896;" Command="{Binding ViewerDownloadCommand}" ToolTip="{loc:Tr 'Herunterladen'}"/>
                    <StackPanel Margin="10,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ViewerItem.Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ViewerInfo}" Foreground="#AAFFFFFF" FontSize="12"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Button Style="{StaticResource ViewerButton}" Content="&#xE76B;" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0"
                    Command="{Binding ViewerPreviousCommand}" IsEnabled="{Binding CanViewPrevious}"/>
            <Button Style="{StaticResource ViewerButton}" Content="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0"
                    Command="{Binding ViewerNextCommand}" IsEnabled="{Binding CanViewNext}"/>
            <TextBlock Text="{Binding ViewerCounter}" Foreground="#99FFFFFF" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        </Grid>
    </Grid>
</Window>
