<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- NFM-Server: Hosting-Dienst ohne Oberfläche (Windows, Linux, macOS).
       Passwortgeschützte, verschlüsselte Ordner · Profile · Admin · HTTPS-API · WebDAV · Web-App -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>nfm-server</AssemblyName>
    <RootNamespace>NetworkFolderManager.Server</RootNamespace>
    <Version>1.1.1</Version>
    <Company>noobnet.eu</Company>
    <Authors>noobnet.eu</Authors>
    <Copyright>© 2026 noobnet.eu</Copyright>
    <Product>NetworkFolderManager Server</Product>
    <Description>NetworkFolderManager Server: encrypted, password-protected network folders</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- ASP0016: Fehlalarm für die inneren Lambdas in Api.cs – Api.Run schreibt das Ergebnis selbst (ExecuteAsync) -->
    <NoWarn>$(NoWarn);ASP0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web-App eingebettet, damit sie auch in der Einzeldatei steckt -->
    <Content Remove="wwwroot\**" />
    <None Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\*" LogicalName="www/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gemeinsame Datenmodelle mit der Windows-App -->
    <Compile Include="..\NetworkFolderManager\Models\VaultModels.cs" Link="Shared\VaultModels.cs" />
  </ItemGroup>

</Project>
